# Noch nicht in Suchmaschinen: diese Zeilen und das robots-Meta in src/site-head.html entfernen, wenn es losgehen soll.
/*
  X-Robots-Tag: noindex, nofollow
# Schriften und Bilder dürfen lange im Browser bleiben (die Schriftdateien ändern sich nie, sonst neuer Name)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/ratgeber/img/*
  Cache-Control: public, max-age=604800
/ratgeber/:slug/og.png
  Cache-Control: public, max-age=604800
