        <age>0</age>
      </label>
      <label name="recht3">
        <unit>folder</unit>
        <scope>https://www.zparkling.com/impressum/</scope>
        <protocol>all</protocol>
        <age>0</age>
      </label>
      <label name="recht4">
        <unit>folder</unit>
        <scope>https://www.zparkling.com/datenschutz/</scope>
        <protocol>all</protocol>
        <age>0</age>
      </label>
    </labeltype-xmlfile>
  </ageblock-labeltype-definition>
</age-declaration>
